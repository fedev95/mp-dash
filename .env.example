# Copy this file to .env and fill in your real Firebase project credentials
# (Project settings > General > Your apps > SDK setup and configuration).
FIREBASE_API_KEY=AIzaSyDUMMY_KEY_0000000000000000000000
FIREBASE_AUTH_DOMAIN=demo-mp-dash.firebaseapp.com
FIREBASE_PROJECT_ID=demo-mp-dash
FIREBASE_STORAGE_BUCKET=demo-mp-dash.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Ensures file-change detection works inside Docker on all platforms.
CHOKIDAR_USEPOLLING=true

# Public demo: shows warnings and sample files. Keep false for personal use.
DEMO_MODE=false

# Optional reCAPTCHA (Fraud Defense) site key for Firebase App Check (public demo only).
APP_CHECK_SITE_KEY=
